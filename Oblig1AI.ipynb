    "Grc_df['Item_MRP']\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "# Select the two outlet types\n",
    "\n",
    "#only selecting the supermarket Type 1 \n",
    "sup1 = Grc_df[Grc_df['Outlet_Type'] == 'Supermarket Type1']\n",
    "\n",
    "#only selecting the supermarket Type 2\n",
    "sup2 = Grc_df[Grc_df['Outlet_Type'] == 'Supermarket Type2']\n",
    "\n",
    "# Create a 2 x 1 subplot\n",
    "fig, axes = plt.subplots(2, 1, figsize=(8, 10))\n",
    "\n",
    "# Supermarket Type 1\n",
    "sns.boxplot(data=sup1, x='Item_MRP', ax=axes[0])\n",
    "axes[0].set_title('Supermarket Type1 - Item MRP')\n",
    "\n",
    "# Supermarket Type 2\n",
    "sns.boxplot(data=sup2, x='Item_MRP', ax=axes[1])\n",
    "axes[1].set_title('Supermarket Type2 - Item MRP')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "Q1 = sup1['Item_MRP'].quantile(0.25)\n",
    "Q3 = sup1['Item_MRP'].quantile(0.75)\n",
    "\n",
    "IQR = Q3 - Q1\n",
    "\n",
    "lower = Q1 - 1.5 * IQR\n",
    "upper = Q3 + 1.5 * IQR\n",
    "\n",
    "outliers = sup1[(sup1['Item_MRP'] < lower) | (sup1['Item_MRP'] > upper)]\n",
    "\n",
    "print(outliers)\n",
    "\n",
    "Q1 = sup2['Item_MRP'].quantile(0.25)\n",
    "Q3 = sup2['Item_MRP'].quantile(0.75)\n",
    "\n",
    "IQR = Q3 - Q1\n",
    "\n",
    "lower = Q1 - 1.5 * IQR\n",
    "upper = Q3 + 1.5 * IQR\n",
    "\n",
    "outliers = sup2[(sup2['Item_MRP'] < lower) | (sup2['Item_MRP'] > upper)]\n",
    "\n",
    "print(outliers)\n",
    "\n",
    "print(\"Type 1 median:\", sup1['Item_MRP'].median())\n",
    "print(\"Type 2 median:\", sup2['Item_MRP'].median())"
   ]
